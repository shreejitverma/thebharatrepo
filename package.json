{
  "name": "thebharatrepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "tsx scripts/build-content.ts",
    "dev": "next dev",
    "prebuild": "npm run content:validate && tsx scripts/content-verify-sources.ts --offline && tsx scripts/build-content.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "content:validate": "tsx scripts/content-validate.ts",
    "content:report": "tsx scripts/content-validate.ts --report",
    "content:verify-sources": "tsx scripts/content-verify-sources.ts",
    "content:build": "tsx scripts/build-content.ts",
    "test:e2e": "playwright test",
    "test:lighthouse": "lhci autorun",
    "content:merge": "tsx scripts/content-merge-staging.ts"
  },
  "dependencies": {
    "fuse.js": "^7.1.0",
    "gray-matter": "^4.0.3",
    "next": "16.4.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
